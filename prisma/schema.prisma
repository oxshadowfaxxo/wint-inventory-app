// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum InventoryCountStatus {
  DRAFT
  COUNTING
  REVIEW
  COMPLETED
  CANCELLED
}

enum InventoryLineStatus {
  UNCOUNTED
  COUNTED
  RECOUNT
  APPROVED
  EXCLUDED
}

enum InventoryCountType {
  PRODUCT_TYPE
  BLANK_SCAN
}

model InventoryCount {
  id           String               @id @default(cuid())
  shop         String
  countNumber  Int
  name         String
  locationId   String
  locationName String
  area         String
  productTypes Json
  countType    InventoryCountType   @default(PRODUCT_TYPE)
  status       InventoryCountStatus @default(DRAFT)
  createdBy    String?
  startedAt    DateTime?
  completedAt  DateTime?
  archivedAt   DateTime?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  lines        InventoryCountLine[]
  scanEvents   InventoryScanEvent[]

  @@index([shop, locationId])
  @@index([shop, status])
  @@index([shop, archivedAt])
  @@unique([shop, countNumber])
}

model InventoryCountLine {
  id                 String              @id @default(cuid())
  inventoryCountId   String
  inventoryItemId    String
  productId          String
  variantId          String
  productTitle       String
  variantTitle       String?
  vendor             String?
  productType        String?
  sku                String?
  barcode            String?
  startingQuantity   Int?
  countedQuantity    Int                 @default(0)
  committedUncounted Boolean             @default(false)
  approvedQuantity   Int?
  status             InventoryLineStatus @default(UNCOUNTED)
  note               String?
  firstScannedAt     DateTime?
  lastScannedAt      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryCount     InventoryCount      @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  scanEvents         InventoryScanEvent[]

  @@unique([inventoryCountId, inventoryItemId])
  @@index([inventoryCountId])
  @@index([barcode])
  @@index([status])
}

model InventoryScanEvent {
  id                   String              @id @default(cuid())
  inventoryCountId     String
  inventoryCountLineId String?
  barcode              String
  quantityChange       Int                 @default(1)
  scannedBy            String?
  scannedAt            DateTime            @default(now())
  deviceId             String?
  result               String
  errorMessage         String?
  inventoryCount       InventoryCount      @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  inventoryCountLine   InventoryCountLine? @relation(fields: [inventoryCountLineId], references: [id], onDelete: SetNull)

  @@index([inventoryCountId])
  @@index([barcode])
  @@index([scannedAt])
}
